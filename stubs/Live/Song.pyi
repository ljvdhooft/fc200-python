from collections.abc import Sequence

from . import Listener
from .Scene import Scene
from .Track import Track

class Song:
    class View:
        selected_scene: Scene
        def add_selected_scene_listener(self, listener: Listener) -> None: ...
        def remove_selected_scene_listener(self, listener: Listener) -> None: ...
        def selected_scene_has_listener(self, listener: Listener) -> bool: ...

    view: View
    tracks: Sequence[Track]
    scenes: Sequence[Scene]
    is_playing: bool
    metronome: bool

    def tap_tempo(self) -> None: ...
    def start_playing(self) -> None: ...
    def stop_playing(self) -> None: ...
    def stop_all_clips(self, quantized: bool = ...) -> None: ...

    def add_is_playing_listener(self, listener: Listener) -> None: ...
    def remove_is_playing_listener(self, listener: Listener) -> None: ...
    def is_playing_has_listener(self, listener: Listener) -> bool: ...
    def add_metronome_listener(self, listener: Listener) -> None: ...
    def remove_metronome_listener(self, listener: Listener) -> None: ...
    def metronome_has_listener(self, listener: Listener) -> bool: ...
    def add_is_ableton_link_enabled_listener(self, listener: Listener) -> None: ...
    def remove_is_ableton_link_enabled_listener(self, listener: Listener) -> None: ...
    def is_ableton_link_enabled_has_listener(self, listener: Listener) -> bool: ...
