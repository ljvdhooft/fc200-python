from collections.abc import Callable

class Task:
    def kill(self) -> None: ...

class TaskGroup:
    def add(self, task: Task | Callable[..., object]) -> Task: ...

def sequence(*tasks: Task) -> Task: ...
def wait(seconds: float) -> Task: ...
def run(func: Callable[[], object]) -> Task: ...
def loop(task: Task) -> Task: ...
