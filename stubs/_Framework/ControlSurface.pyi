from Live.Song import Song

from .Task import TaskGroup

class ControlSurface:
    _tasks: TaskGroup

    def __init__(self, c_instance: object) -> None: ...
    def song(self) -> Song: ...
    def log_message(self, *message: object) -> None: ...
    def show_message(self, message: str) -> None: ...
    def _send_midi(self, midi_event_bytes: tuple[int, ...], optimized: bool = ...) -> bool: ...
    def handle_sysex(self, midi_bytes: tuple[int, ...]) -> None: ...
    def disconnect(self) -> None: ...
