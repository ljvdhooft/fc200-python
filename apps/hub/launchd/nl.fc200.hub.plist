<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.fc200.hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HUB_DIR@/.venv/bin/python</string>
    <string>-m</string>
    <string>fc200_hub</string>
    <string>--port</string>
    <string>200</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HUB_DIR@</string>
  <!-- Not at login: the Remote Script starts it with Live and stops it on unload
       (src/hub_service.py). launchd only restarts it after a crash -->
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/fc200-hub.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/fc200-hub.log</string>
</dict>
</plist>
