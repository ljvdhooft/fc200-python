<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.fc200.hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HUB_DIR@/.venv/bin/python</string>
    <string>-m</string>
    <string>fc200_hub</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@HUB_DIR@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/fc200-hub.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/fc200-hub.log</string>
</dict>
</plist>
